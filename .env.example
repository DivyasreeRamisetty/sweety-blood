# ==============================================================================
# Sweety – Blood Glucose Tracker Environment Variables
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JWT Authentication Secret Key
# Replace with a strong random string in production (e.g., generated with `openssl rand -base64 32`)
JWT_SECRET="sweety-super-secure-production-jwt-token-secret-kenpath-2026"

# Token Expiration (e.g. '7d', '24h', '1h')
JWT_EXPIRES_IN="7d"

# Database Configuration:
# Sweety includes an embedded PostgreSQL engine powered by @electric-sql/pglite
# which runs full Postgres 15/16 C-WASM with persistence in ./data/pgdata.
# Zero external database installation is required for instant setup.
# 
# Optionally, if you wish to connect to an external PostgreSQL instance (Docker, Neon, RDS, Supabase):
# DATABASE_URL="postgresql://username:password@localhost:5432/sweety_glucose"
# Or standard Postgres variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=secret
# PGDATABASE=sweety_glucose

# GEMINI_API_KEY: Optional for AI glucose pattern analysis & clinical dietary suggestions
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this applet is hosted
APP_URL="http://localhost:3000"

